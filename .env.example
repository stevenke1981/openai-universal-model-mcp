# Create an API key in your OpenAI Platform project settings.
# Keep this file private. Never commit a populated .env file.
OPENAI_API_KEY=

# Optional: request timeout in seconds (default: 180).
OPENAI_TIMEOUT_SECONDS=180

# Optional: directory where generated images and audio are saved.
# Relative paths are resolved from the project root.
OPENAI_ARTIFACT_DIR=artifacts
